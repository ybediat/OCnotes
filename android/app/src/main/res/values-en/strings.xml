    <!-- ================================================================
         Synchronisation

         Le résumé décrit ce qui s\'est passé plutôt que de conclure. Une
         panne réseau donne un état partiel, pas un échec : « 3 notes
         envoyées, 2 en attente » est exact, là où « échec » ferait croire
         à une perte.
         ================================================================ -->
    <plurals name="sync_notes_envoyees">
        <item quantity="one">%d note sent</item>
        <item quantity="other">%d notes sent</item>
    </plurals>
    <plurals name="sync_deplacements">
        <item quantity="one">%d move</item>
        <item quantity="other">%d moves</item>
    </plurals>
    <plurals name="sync_suppressions">
        <item quantity="one">%d deletion</item>
        <item quantity="other">%d deletions</item>
    </plurals>
    <plurals name="sync_en_attente">
        <item quantity="one">%d pending</item>
        <item quantity="other">%d pending</item>
    </plurals>
