<?xml version="1.0" encoding="utf-8"?>
<!--
    Traduction anglaise.

    La référence est `values/strings.xml`, en français : elle seule fait foi,
    elle seule est touchée par le code. Ce fichier-ci est le modèle des
    langues suivantes. Ce qu'il montre, dans l'ordre où l'on s'y trompe :

      - les `name` sont recopiés à l'identique, jamais traduits ;
      - les entrées `translatable="false"` de la référence ne sont **pas**
        reprises — une clé en trop est une erreur de lint au même titre
        qu'une clé manquante ;
      - un `%1$s` ou un `%d` se déplace dans la phrase mais ne disparaît
        jamais : les indices `%1$`, `%2$` servent justement à réordonner ce
        que la grammaire d'une langue impose de réordonner ;
      - une apostrophe s'écrit \' , sinon la compilation des ressources
        échoue sur « Invalid unicode escape sequence », un message qui ne
        désigne pas sa cause ;
      - une chaîne dont les espaces de bord comptent est encadrée de
        guillemets droits — voir le séparateur de sous-titre plus bas.
        Sans eux, aapt les supprime sans rien dire ;
      - un `<plurals>` porte les formes de SA langue : deux en anglais,
        trois en polonais, six en arabe, une seule en japonais. Ce n'est pas
        une copie des deux formes françaises.

    Une langue s'ajoute par deux gestes solidaires : ce fichier, et une ligne
    dans `res/xml/locales_config.xml`. L'un sans l'autre donne soit un choix
    qui ne change rien, soit des ressources qu'Android n'annonce pas.
--><resources>
    <!-- ================================================================
         Éléments communs

         Les libellés que plusieurs écrans partagent vivent ici. Les
         dupliquer par écran ferait diverger deux boutons qui portent le
         même geste — une traduction sur deux, et rien pour le signaler.
         ================================================================ -->
    <string name="action_annuler">Cancel</string>
    <string name="action_supprimer">Delete</string>
    <string name="action_deplacer">Move</string>
    <string name="action_renommer">Rename</string>
    <string name="action_creer">Create</string>
    <string name="action_retour">Back</string>

    <!-- Un constat, pas une erreur : la vue vient du cache, elle est
         utilisable, elle peut simplement être incomplète. -->
    <string name="commun_bandeau_cache">Server unreachable — view reconstructed from cache. It may be incomplete.</string>

    <!-- ================================================================
         Erreurs

         Les catégories de transport ([AUTH], [CONFLICT]…) sont reformulées
         plutôt que relayées : « HTTP 502 » sur une URL WebDAV n\'apprend rien
         à personne. Les codes locaux ([NAME_*], [STORAGE_IO]…) viennent du
         cœur Go, qui refuse de créer un nom que le cache ne saurait écrire.
         ================================================================ -->
    <string name="err_auth">Credentials rejected. Check the username and App Token, which may have expired.</string>
    <string name="err_conflit">This note was modified elsewhere in the meantime.</string>
    <string name="err_introuvable">Not found on the server. The note or folder may have been deleted from another device.</string>
    <string name="err_http">The server is currently unreachable.</string>
    <string name="err_hors_ligne">Server unreachable. Try again once the network is back.</string>
    <string name="err_inconnue">Operation failed.</string>

    <string name="err_nom_vide">The name cannot be empty.</string>
    <string name="err_nom_reserve">This name is reserved by the system.</string>
    <!-- %1$d vient de Mobile.maxNameBytes() : la borne n\'est pas recopiée ici. -->
    <string name="err_nom_trop_long">The name is too long: %1$d bytes maximum.</string>
    <!-- %1$s vient de Mobile.forbiddenNameChars(), pour la même raison. -->
    <string name="err_nom_caracteres_interdits">The name cannot contain these characters: %1$s</string>
    <string name="err_nom_caractere_controle">The name contains an invisible character.</string>
    <string name="err_nom_espaces">The name cannot begin or end with a space.</string>
    <string name="err_nom_point_final">The name cannot end with a period.</string>
    <string name="err_nom_point_initial">The name cannot begin with a period.</string>
    <string name="err_nom_reserve_windows">This name is reserved by Windows and cannot be used.</string>
    <string name="err_nom_aucun_libre">Too many notes already have this name.</string>
    <string name="err_racine_protegee">The notes folder itself cannot be renamed, moved, or deleted.</string>
    <string name="err_deplacement_dans_soi">A folder cannot be moved into itself.</string>
    <string name="err_chemin_vide">No item specified.</string>
    <string name="err_dossier_hors_ligne">A folder cannot be renamed, moved, or deleted while offline. Reconnect first.</string>
    <string name="err_stockage">Unable to write to the device storage. Check the available space.</string>
    <string name="err_url_serveur_manquante">Enter the server address.</string>
    <string name="err_url_serveur_invalide">Invalid server address. It must start with http:// or https://</string>
    <string name="err_utilisateur_manquant">Enter your username.</string>

