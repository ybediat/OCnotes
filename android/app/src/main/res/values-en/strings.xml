    <!-- ================================================================
         Connexion

         L'aide sur les App Tokens n'est pas décorative : personne ne devine
         qu'il faut créer un jeton dédié plutôt que saisir son mot de passe,
         et c'est le premier point de blocage d'une application auto-hébergée.
         Le chemin de menu doit rester celui d'OpenCloud, dans la langue où
         OpenCloud l'affiche.
         ================================================================ -->
    <string name="login_accroche">Your Markdown notes, on your OpenCloud server.</string>
    <string name="login_serveur_label">Server address</string>
    <string name="login_serveur_exemple">https://cloud.example.com</string>
    <string name="login_utilisateur_label">Username</string>
    <string name="login_token_label">App Token</string>
    <string name="login_token_afficher">Show token</string>
    <string name="login_token_masquer">Hide token</string>
    <!-- Un échec réseau ne demande aucune correction : le libellé invite à
         réessayer, pas à recommencer la saisie. -->
    <string name="login_connecter">Sign in</string>
    <string name="login_reessayer">Try again</string>
    <string name="login_aide_titre">Don\'t have an App Token yet?</string>
    <string name="login_aide_chemin">In OpenCloud: Account Settings → App Tokens → + New. Give it a name and an expiration date. The token is shown only once, so copy it immediately.</string>
    <string name="login_aide_revocation">It is not your password: an App Token can be revoked without changing your credentials.</string>

