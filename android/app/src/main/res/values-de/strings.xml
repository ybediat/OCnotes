    <!-- ================================================================
         Gemeinsame Elemente

         Beschriftungen, die von mehreren Bildschirmen gemeinsam genutzt werden, leben hier.
         Sie zu duplizieren würde dazu führen, dass zwei Schaltflächen mit derselben Aktion
         unterschiedlich übersetzt werden – eine Übersetzung fehlt, und es gibt keine Warnung.
         ================================================================ -->
    <string name="action_annuler">Abbrechen</string>
    <string name="action_supprimer">Löschen</string>
    <string name="action_deplacer">Verschieben</string>
    <string name="action_renommer">Umbenennen</string>
