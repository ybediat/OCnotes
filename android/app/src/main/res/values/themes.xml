<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème de démarrage uniquement : tout le reste est peint par Compose
         (voir ui/theme/Theme.kt). Il évite l'éclair blanc au lancement.

         Le framework ne fournit pas de variante « DayNight » de Theme.Material :
         le mode sombre passe donc par values-night/themes.xml. Theme.DeviceDefault.DayNight
         existerait, mais seulement à partir de l'API 29, alors que minSdk vaut 26. -->
    <style name="Theme.OCnotes" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>
</resources>
