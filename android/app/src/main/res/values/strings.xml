<?xml version="1.0" encoding="utf-8"?>
<!--
    Textes de l'interface.

    Ce fichier est la langue de référence, le français. Une traduction se fait
    en copiant le fichier dans `values-<langue>/` et en n'y traduisant que les
    valeurs : jamais les `name`, jamais les `%1$s`.

    Trois règles à ne pas perdre de vue :

      - une apostrophe doit s'écrire \' , sinon la compilation des ressources
        échoue ;
      - un texte qui compte quelque chose est un <plurals>, jamais un
        `if (n > 1)` : le nombre de formes dépend de la langue ;
      - `translatable="false"` marque ce qui ne doit pas être traduit.
-->
<resources>
    <string name="app_name" translatable="false">OpenNote</string>

    <!-- ================================================================
         Éléments communs

         Les libellés que plusieurs écrans partagent vivent ici. Les
         dupliquer par écran ferait diverger deux boutons qui portent le
         même geste — une traduction sur deux, et rien pour le signaler.
         ================================================================ -->
    <string name="action_annuler">Annuler</string>
    <string name="action_supprimer">Supprimer</string>
    <string name="action_renommer">Renommer</string>
    <string name="action_creer">Créer</string>
    <string name="action_retour">Retour</string>

    <!-- Valeur absente dans une fiche de réglages : un tiret cadratin, le
         même dans toutes les langues. -->
    <string name="commun_valeur_vide" translatable="false">—</string>

    <!-- Un constat, pas une erreur : la vue vient du cache, elle est
         utilisable, elle peut simplement être incomplète. -->
    <string name="commun_bandeau_cache">Serveur injoignable — vue reconstituée depuis le cache. Elle peut être incomplète.</string>

    <!-- ================================================================
         Erreurs

         Les catégories de transport ([AUTH], [CONFLICT]…) sont reformulées
         plutôt que relayées : « HTTP 502 » sur une URL WebDAV n\'apprend rien
         à personne. Les codes locaux ([NAME_*], [STORAGE_IO]…) viennent du
         cœur Go, qui refuse de créer un nom que le cache ne saurait écrire.
         ================================================================ -->
    <string name="err_auth">Identifiants refusés. Vérifiez le nom d\'utilisateur et l\'App Token, qui a pu expirer.</string>
    <string name="err_conflit">Cette note a été modifiée ailleurs entre-temps.</string>
    <string name="err_introuvable">Introuvable sur le serveur. La note ou le dossier a peut-être été supprimé depuis un autre appareil.</string>
    <string name="err_http">Le serveur est injoignable pour le moment.</string>
    <string name="err_hors_ligne">Serveur injoignable. Réessayez une fois le réseau revenu.</string>
    <string name="err_inconnue">Opération impossible.</string>

    <string name="err_nom_vide">Le nom ne peut pas être vide.</string>
    <string name="err_nom_reserve">Ce nom est réservé par le système.</string>
    <!-- %1$d vient de Mobile.maxNameBytes() : la borne n\'est pas recopiée ici. -->
    <string name="err_nom_trop_long">Le nom est trop long : %1$d octets au maximum.</string>
    <!-- %1$s vient de Mobile.forbiddenNameChars(), pour la même raison. -->
    <string name="err_nom_caracteres_interdits">Le nom ne peut pas contenir ces caractères : %1$s</string>
    <string name="err_nom_caractere_controle">Le nom contient un caractère invisible.</string>
    <string name="err_nom_espaces">Le nom ne peut pas commencer ni finir par une espace.</string>
    <string name="err_nom_point_final">Le nom ne peut pas finir par un point.</string>
    <string name="err_nom_point_initial">Le nom ne peut pas commencer par un point.</string>
    <string name="err_nom_reserve_windows">Ce nom est réservé par Windows et ne peut pas être utilisé.</string>
    <string name="err_nom_aucun_libre">Trop de notes portent déjà ce nom.</string>
    <string name="err_racine_protegee">Le dossier de notes lui-même ne peut être ni renommé, ni déplacé, ni supprimé.</string>
    <string name="err_deplacement_dans_soi">Un dossier ne peut pas être déplacé dans lui-même.</string>
    <string name="err_chemin_vide">Aucun élément désigné.</string>
    <string name="err_stockage">Impossible d\'écrire sur le stockage de l\'appareil. Vérifiez l\'espace disponible.</string>
    <string name="err_url_serveur_manquante">Indiquez l\'adresse du serveur.</string>
    <string name="err_url_serveur_invalide">Adresse de serveur invalide. Elle doit commencer par http:// ou https://</string>
    <string name="err_utilisateur_manquant">Indiquez votre nom d\'utilisateur.</string>

    <!-- ================================================================
         Démarrage
         ================================================================ -->
    <string name="demarrage_token_refuse">Votre App Token n\'est plus accepté par le serveur. Il a sans doute expiré : créez-en un nouveau et saisissez-le.</string>
    <string name="demarrage_espace_hors_ligne">Il reste un espace de notes à choisir, et cette étape demande une connexion au serveur. Réessayez une fois le réseau revenu.</string>

    <!-- ================================================================
         Connexion

         L'aide sur les App Tokens n'est pas décorative : personne ne devine
         qu'il faut créer un jeton dédié plutôt que saisir son mot de passe,
         et c'est le premier point de blocage d'une application auto-hébergée.
         Le chemin de menu doit rester celui d'OpenCloud, dans la langue où
         OpenCloud l'affiche.
         ================================================================ -->
    <string name="login_accroche">Vos notes Markdown, sur votre serveur OpenCloud.</string>
    <string name="login_serveur_label">Adresse du serveur</string>
    <string name="login_serveur_exemple">https://cloud.exemple.fr</string>
    <string name="login_utilisateur_label">Nom d\'utilisateur</string>
    <string name="login_token_label">App Token</string>
    <string name="login_token_afficher">Afficher le token</string>
    <string name="login_token_masquer">Masquer le token</string>
    <!-- Un échec réseau ne demande aucune correction : le libellé invite à
         réessayer, pas à recommencer la saisie. -->
    <string name="login_connecter">Se connecter</string>
    <string name="login_reessayer">Réessayer</string>
    <string name="login_aide_titre">Pas encore d\'App Token ?</string>
    <string name="login_aide_chemin">Dans OpenCloud : Réglages du compte → App Tokens → + New. Donnez-lui un nom et une date d\'expiration. Le jeton n\'est affiché qu\'une seule fois, copiez-le tout de suite.</string>
    <string name="login_aide_revocation">Ce n\'est pas votre mot de passe : un App Token se révoque sans changer vos identifiants.</string>

    <!-- ================================================================
         Choix de l'espace

         Un espace inutilisable reste visible mais grisé, avec l'explication
         de son inaptitude : l'utilisateur le voit dans son navigateur web et
         se demanderait où il est passé.
         ================================================================ -->
    <string name="espace_titre">Où ranger vos notes ?</string>
    <string name="espace_stockage">Espace de stockage</string>
    <string name="espace_dossier_titre">Dossier de notes</string>
    <string name="espace_chemin_label">Chemin dans l\'espace</string>
    <string name="espace_chemin_aide">Le dossier est créé s\'il n\'existe pas. Laissez le champ vide pour utiliser la racine de l\'espace, par exemple si vos notes y sont déjà.</string>
    <string name="espace_continuer">Continuer</string>
    <string name="espace_preparation">Préparation…</string>
    <string name="espace_virtuel">Agrégat des dossiers partagés avec vous, pas un espace de stockage : on ne peut pas y créer de dossier de notes.</string>
    <string name="espace_inutilisable">Cet espace ne peut pas héberger de notes.</string>
    <string name="espace_personnel">Votre espace personnel</string>
    <string name="espace_projet">Espace de projet partagé</string>
    <string name="espace_monte">Dossier monté</string>

    <!-- ================================================================
         Synchronisation

         Le résumé décrit ce qui s\'est passé plutôt que de conclure. Une
         panne réseau donne un état partiel, pas un échec : « 3 notes
         envoyées, 2 en attente » est exact, là où « échec » ferait croire
         à une perte.
         ================================================================ -->
    <plurals name="sync_notes_envoyees">
        <item quantity="one">%d note envoyée</item>
        <item quantity="other">%d notes envoyées</item>
    </plurals>
    <plurals name="sync_deplacements">
        <item quantity="one">%d déplacement</item>
        <item quantity="other">%d déplacements</item>
    </plurals>
    <plurals name="sync_suppressions">
        <item quantity="one">%d suppression</item>
        <item quantity="other">%d suppressions</item>
    </plurals>
    <plurals name="sync_en_attente">
        <item quantity="one">%d en attente</item>
        <item quantity="other">%d en attente</item>
    </plurals>
