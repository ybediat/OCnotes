<?xml version="1.0" encoding="utf-8"?>
<!--
    Chemins exposés par le FileProvider de partage.

    Racine cacheDir/partage/, avec un sous-dossier unique par partage. Les
    copies au vrai nom expirent après une heure et sont nettoyées au lancement.
-->
<paths>
    <cache-path name="partage" path="partage/" />
</paths>
